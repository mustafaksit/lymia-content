            },
            {
              "text": "The animal wanted to get out very badly.",
              "audioStart": 14.363,
              "audioEnd": 16.512
            },
            {
              "text": "However, the door was locked close.",
              "audioStart": 17.375,
              "audioEnd": 19.55
            },
            {
              "text": "Soon, a poor man walked past the building on his way through the forest.",
              "audioStart": 20.413,
