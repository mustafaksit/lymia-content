              "text": "He added that everyone would act the same way in this case.",
              "audioStart": 68.362,
              "audioEnd": 71.325
            },
            {
              "text": "They agreed to ask three different things in the forest.",
              "audioStart": 72.188,
              "audioEnd": 74.838
            },
            {
              "text": "They wanted to see if that strange rule was true.",
              "audioStart": 75.7,
              "audioEnd": 78.037
            },
