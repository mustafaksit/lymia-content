              "audioEnd": 224.9
            }
          ]
        },
        {
          "sentences": [
            {
              "text": "Even today, tourists arrive on boats to catch a sight of the famous creature near the water.",
              "audioStart": 225.762,
              "audioEnd": 230.45
            },
            {
              "text": "They walk along the sand and take pictures of the thick lines upon his body.",
