              "audioStart": 164.139,
              "audioEnd": 166.708
            },
            {
              "text": "Spring came back to the final corner of the land.",
              "audioStart": 167.667,
              "audioEnd": 170.319
            },
            {
              "text": "Birds began to sing their happy songs once more.",
              "audioStart": 171.278,
              "audioEnd": 174.111
            }
